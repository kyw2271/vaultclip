{
  "manifest_version": 3,
  "name": "VaultClip - Markdown + PDF",
  "version": "1.0.0",
  "description": "Save the current page to a local vault as a compact Markdown note linked to a full PDF archive.",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "storage"
  ],
  "action": {
    "default_title": "VaultClip",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}